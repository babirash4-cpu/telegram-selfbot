# ==========================================
# تنظیمات سلف بات تک کاربره تلگرام (Railway)
# ==========================================

# اطلاعات API تلگرام از سایت my.telegram.org
API_ID=12345678
API_HASH=abcdef0123456789abcdef0123456789

# سشن استرینگ اکانت شما (تولید شده با generate_session.py یا بات سشن‌ساز)
SESSION_STRING=BQAz...

# توکن ربات هلپر جهت پنل شیشه‌ای اختصاصی (اختیاری ولی شدیداً توصیه شده از @BotFather)
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# آیدی عددی تلگرام شما (تنها کاربر مجاز ربات)
OWNER_ID=123456789

# پیشوند دستورات سلف (پیش‌فرض: .)
PREFIX=.

# تایم‌زون ساعت سلف
TZ=Asia/Tehran

# پورت سرور وب کوچک برای زنده نگه‌داشتن روی ریل‌وی (اختیاری)
PORT=8080
